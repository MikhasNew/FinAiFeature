@using WebDebugger.Components.Models
@using EfcToXamarinAndroid.Core
@using EfcToXamarinAndroid.Core.ViewModels
@inject MainViewModel VM

<div class="pa-4" style="min-width: 300px;">
    <MudText Typo="Typo.h6" Class="mb-4">Фильтры</MudText>

    <MudDateRangePicker Label="Период" @bind-DateRange="DateRange" Margin="Margin.Dense" Variant="Variant.Outlined" />

    <MudNumericField T="decimal?" Label="Мин сумма" @bind-Value="MinAmount" Margin="Margin.Dense" Variant="Variant.Outlined" Class="mt-3" />
    <MudNumericField T="decimal?" Label="Макс сумма" @bind-Value="MaxAmount" Margin="Margin.Dense" Variant="Variant.Outlined" Class="mt-2" />

    @* Фильтр по Описанию (Текст из СМС) *@
    <MudTextField T="string" Label="Поиск по описанию"
                  @bind-Value="Description"
                  Class="mt-3"
                  Margin="Margin.Dense"
                  Variant="Variant.Outlined"
                  Clearable="true"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.Search" />

    @* Фильтр по Категории (MCC Description) *@
    <MudAutocomplete T="string" Label="Категория"
                     @bind-Value="MccDescription"
                     SearchFunc="@SearchMccCategories"
                     ResetValueOnEmptyText="true"
                     CoerceText="true"
                     Clearable="true"
                     Margin="Margin.Dense"
                     Variant="Variant.Outlined"
                     Class="mt-3" />

    @* Фильтр по Тегам (Из Title) *@
    <MudAutocomplete T="string" Label="Тэг"
                     @bind-Value="Tag"
                     SearchFunc="@SearchTags"
                     ResetValueOnEmptyText="true"
                     CoerceText="true"
                     Clearable="true"
                     Margin="Margin.Dense"
                     Variant="Variant.Outlined"
                     Class="mt-3" />

    <div class="d-flex justify-space-between mt-6">
        <MudButton Variant="Variant.Text" OnClick="Clear" Color="Color.Error">Сбросить</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Apply">Применить</MudButton>
    </div>
</div>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private DateRange DateRange { get; set; }
    private decimal? MinAmount { get; set; }
    private decimal? MaxAmount { get; set; }
    private string? Description { get; set; }
    private string? MccDescription { get; set; }
    private string? Tag { get; set; }

    // Поиск для Autocomplete Категорий
    private async Task<IEnumerable<string>> SearchMccCategories(string value, CancellationToken token)
    {
        var allMccDescriptions = VM.AllItems
            .Where(x => !string.IsNullOrEmpty(x.MccDescription))
            .Select(x => x.MccDescription!)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        if (string.IsNullOrEmpty(value))
            return allMccDescriptions;

        return allMccDescriptions.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    // Метод поиска тегов
    private async Task<IEnumerable<string>> SearchTags(string value, CancellationToken token)
    {
        var allTags = await VM.GetTags();

        if (string.IsNullOrEmpty(value))
            return allTags;

        return allTags.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task Apply()
    {
        VM.SetAdvancedFilters(DateRange, MinAmount, MaxAmount, Description, MccDescription, Tag);
        await OpenChanged.InvokeAsync(false);
    }

    private async Task Clear()
    {
        VM.ClearAdvancedFilters();
        
        DateRange = null;
        MinAmount = null;
        MaxAmount = null;
        Description = null;
        MccDescription = null;
        Tag = null;

        await OpenChanged.InvokeAsync(false);
    }
}
