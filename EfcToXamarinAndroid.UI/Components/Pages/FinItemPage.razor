@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@using EfcToXamarinAndroid.UI.Components.Models
@using EfcToXamarinAndroid.Core
@using EfcToXamarinAndroid.Core.ViewModels




<MudContainer MaxWidth="MaxWidth.ExtraLarge" Style=" padding: 0px; ">
    <MudGrid Class="pt-4">
        <MudItem xs="12" sm="12">
            <MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors">
                <MudSelect Variant="Variant.Outlined"
                           T="OperacionTyps"
                           Dense="true"
                           Label="Operation Type"
                           @bind-Value=Item.OperationType
                           ReadOnly="!Editable">
                    @foreach (var i in (Enum.GetValues<OperacionTyps>()))
                    {
                        <MudSelectItem Value="@i">@i</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField Variant="Variant.Outlined" T="float" Label="Summa" @bind-Value="@Item.Sum" ReadOnly="!Editable" />
                <MudGrid>
                    <MudItem xs="6">
                        <MudDatePicker Variant="Variant.Outlined"
                                       PickerVariant="PickerVariant.Dialog"
                                       @bind-Date="OnlyDate"
                                       Label="Date"
                                       ReadOnly="!Editable" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTimePicker Variant="Variant.Outlined"
                                       PickerVariant="PickerVariant.Dialog"
                                       Label="Time"
                                       @bind-Time="OnlyTime"
                                       ReadOnly="!Editable" />
                    </MudItem>
                </MudGrid>
                <MudSelect Variant="Variant.Outlined"
                           Dense="true" T="string"
                           Label="Discription"
                           @bind-Value=Item.Description
                           ReadOnly="!Editable">
                    @foreach (var i in VM.GetDeskriptions(Item.OperationType))
                    {
                        <MudSelectItem Value="@(i)" />
                    }
                </MudSelect>
               
                <MudAutocomplete T="int"
                                 Label="MCC-Code"
                                 Variant="Variant.Outlined"
                                 Dense="true"
                                 @bind-Value="Item.MCC"
                                 SearchFunc="@SearchMccCodes"
                                 CoerceText = "true"
                                 CoerceValue = "true"
                                 ReadOnly="!Editable" 
                                 Clearable="true"
                                 Placeholder="Начните вводить для поиска..." />

                <MudAutocomplete T="string"
                                 Label="MCC-Description"
                                 Variant="Variant.Outlined"
                                 Dense="true"
                                 @bind-Value="Item.MccDescription"
                                 SearchFunc="@SearchMccDescriptions"
                                 ReadOnly="!Editable"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 CoerceValue="true"
                                 Clearable="true"
                                 Placeholder="Начните вводить для поиска..." />


                <AddChipElement Editable="@(Editable)" @bind-ChipValues="ChipValues"></AddChipElement>
            </MudForm>

        </MudItem>
    </MudGrid>
</MudContainer>
@code {
    private string SelectedOperationType { get; set; }
    private string SelectedDiscription { get; set; }
    private string SelectedMCCCode { get; set; }
    private string SelectedMCCDescription { get; set; }

    [Parameter]
    public MainViewModel VM { get; set; }
    [Parameter]
    public string Summa { get; set; } = string.Empty;
    [Parameter]
    public OperacionTyps OperationType { get; set; }
    [Parameter]
    public List<string> Discriptions { get; set; } = new List<string>();
    [Parameter]
    public List<int> MCCCode { get; set; } = new List<int>();
    [Parameter]
    public List<string> MCCDescription { get; set; } = new List<string>();
    [Parameter]
    public FinanceItem Item { get; set; }
    [Parameter]
    public bool Editable
    {
        get => editable;
        set
        {
            editable = value;
            if (editable)
                inputClass = "yesInputClass";
            else
                inputClass = "noInputClass";
        }
    }

    private bool editable = false;
    string inputClass = "noInputClass";

    bool success;
    string[] errors = { };
    MudTextField<string> pwField1;
    MudForm form;

    //public void Add() => ChipValues.Add("Value ");
    public void ClosedChip(MudChip<string> chip) => ChipValues.Remove(chip.Text);

    private DateTime DateTimeValue
    {
        get => Item.Date;
        set => Item.Date = value;
    }

    private DateTime? OnlyDate
    {
        get => DateTimeValue.Date;
        set
        {
            if (value.HasValue)
                DateTimeValue = value.Value.Date + DateTimeValue.TimeOfDay;
        }
    }

    private TimeSpan? OnlyTime
    {
        get => DateTimeValue.TimeOfDay;
        set
        {
            if (value.HasValue)
                DateTimeValue = DateTimeValue.Date + value.Value;
        }
    }

    private Dictionary<string, bool> _chipValues = new();

    [Parameter]
    public Dictionary<string, bool> ChipValues
    {
        get => _chipValues;
        set
        {
            _chipValues = value;
            Item.Title = string.Join(" ", _chipValues.Where(x => x.Value).Select(x => x.Key));
        }
    }

    private async Task SyncChips()
    {
        var dict = new Dictionary<string, bool>();
        if (Editable)
        {
            var allTags = await VM.GetTags();
            foreach (var it in allTags)
                dict.TryAdd(it, false);
        }
        
        if (!string.IsNullOrEmpty(Item.Title))
        {
            var list = Item.Title.Split(" ").ToList().Distinct();
            foreach (var i in list)
            {
                if (!dict.TryAdd(i, true))
                    dict[i] = true;
            }
        }
        _chipValues = dict;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_chipValues.Count == 0 || !Editable)
        {
            await SyncChips();
        }
    }

    private async Task<IEnumerable<int>> SearchMccCodes(string value, CancellationToken token)
    {
        var allCodes = VM.GetMccCodes(Item.OperationType);

        if (string.IsNullOrEmpty(value))
            return allCodes;

        // Поиск кода, который начинается на введенные цифры или содержит их
        return allCodes.Where(x => x.ToString().Contains(value));
    }

    private async Task<IEnumerable<string>> SearchMccDescriptions(string value, CancellationToken token)
    {
        // Получаем актуальный список описаний MCC на основе текущего типа операции
        var allMccDescriptions = VM.GetMccDeskriptons(Item.OperationType);
        // Если поле пустое, показываем весь список (или первые N элементов для скорости)
        if (string.IsNullOrEmpty(value))
            return allMccDescriptions;
        // Фильтруем список: ищем вхождение введенного текста (игнорируя регистр)
        return allMccDescriptions
            .Where(x => x != null && x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
