@page "/"
@using System.Linq

@using EfcToXamarinAndroid.UI.Components.Models
@using EfcToXamarinAndroid.Core.Repository
@using EfcToXamarinAndroid.Core
@using EfcToXamarinAndroid.Core.ViewModels
@using EfcToXamarinAndroid.Core.Services
@using EfcToXamarinAndroid.UI.Services
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject MainViewModel VM

<div class="page-layout">

    @* --- СЛОЙ 1: Статистика (Закреплена сзади) --- *@
    <div class="backdrop-header">
        <MudCarousel Class="stats-carousel"
                     @bind-SelectedIndex="selectedIndex"
                     ShowArrows="false"
                     ShowBullets="false" 
                     AutoCycle="false"
                     TData="object"
                     Style="height: 100%;">

            @* СЛАЙД 0: Чистый денежный поток (Баланс) *@
            <MudCarouselItem Transition="Transition.Slide">
                <div class="stats-card" style="justify-content: center; padding-top: 0;">
                    <MudText Typo="Typo.subtitle2" Style="color: rgba(255,255,255,0.7);">@TitleNetBalance.ToUpper()</MudText>
                    <MudText Typo="Typo.h3" Style="font-weight:900; color: white;">
                         @((VM.FlowStats.TotalIncome - VM.FlowStats.TotalExpense).ToString("N0"))
                    </MudText>
                    
                    <div class="d-flex gap-6 mt-4 justify-center w-100 px-4">
                        @* Доход *@
                        <div class="text-center">
                            <MudText Typo="Typo.caption" Style="color: #81C784;">@LabelIncome</MudText>
                            <MudText Typo="Typo.body2" Style="color: white; font-weight: bold;">@VM.FlowStats.TotalIncome.ToString("N0")</MudText>
                        </div>
                        
                        @* Расход *@
                        <div class="text-center">
                            <MudText Typo="Typo.caption" Style="color: #FF8A80;">@LabelExpense</MudText>
                            <MudText Typo="Typo.body2" Style="color: white; font-weight: bold;">@VM.FlowStats.TotalExpense.ToString("N0")</MudText>
                        </div>

                        @* Лимит/День (восстановлено из оригинала) *@
                        <div class="text-center">
                            <MudText Typo="Typo.caption" Style="color: #64B5F6;">@LabelPerDay</MudText>
                             @if (VM.FlowStats.CalculatedDailyLimit > 0)
                            {
                                <MudText Typo="Typo.body2" Style="color: white; font-weight: bold;">@VM.FlowStats.CalculatedDailyLimit.ToString("N0")</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Warning" Style="font-weight:bold;">Перерасход</MudText>
                            }
                        </div>
                    </div>
                </div>
            </MudCarouselItem>

            @* СЛАЙД 1: Динамика (Bar Chart) *@
            <MudCarouselItem Transition="Transition.Slide">
                <div class="stats-card px-1 pt-4 pb-4">
                    <MudText Typo="Typo.subtitle2" Class="mb-1" Style="color: rgba(255,255,255,0.7);">@VM.DynamicsGroupingTitle</MudText>
                    
                    @* Summary Numbers *@
                    @{
                        var avgIncome = VM.DynamicsStats.DailyIncomeData.DefaultIfEmpty(0).Average();
                        var avgExpense = VM.DynamicsStats.DailyExpenseData.DefaultIfEmpty(0).Average();
                    }

                    @* Summary Numbers *@
                    <div class="d-flex w-100 justify-space-between px-4 mb-2">
                        @* INCOME STATS *@
                        <div class="d-flex flex-column align-start" style="min-height: 40px;"> 
                            @if (avgIncome > 0)
                            {
                                 <MudText Typo="Typo.caption" Style="color: #66BB6A; opacity: 0.9; font-size:10px;">ДОХОД (МАКС / СР)</MudText>
                                 <div class="d-flex gap-1 align-baseline">
                                    <MudText Typo="Typo.subtitle2" Style="color: #66BB6A; font-weight:700;">@VM.DynamicsStats.DailyIncomeData.DefaultIfEmpty(0).Max().ToString("N0")</MudText>
                                    <MudText Typo="Typo.caption" Style="color: #66BB6A; opacity:0.7;">/</MudText>
                                    <MudText Typo="Typo.subtitle2" Style="color: #66BB6A;">@avgIncome.ToString("N0")</MudText>
                                 </div>
                            }
                        </div>

                        @* EXPENSE STATS *@
                        <div class="d-flex flex-column align-end" style="min-height: 40px;">
                            @if (avgExpense > 0)
                            {
                                 <MudText Typo="Typo.caption" Style="color: #EF5350; opacity: 0.9; font-size:10px;">РАСХОД (МАКС / СР)</MudText>
                                 <div class="d-flex gap-1 align-baseline">
                                    <MudText Typo="Typo.subtitle2" Style="color: #EF5350; font-weight:700;">@VM.DynamicsStats.DailyExpenseData.DefaultIfEmpty(0).Max().ToString("N0")</MudText>
                                    <MudText Typo="Typo.caption" Style="color: #EF5350; opacity:0.7;">/</MudText>
                                    <MudText Typo="Typo.subtitle2" Style="color: #EF5350;">@avgExpense.ToString("N0")</MudText>
                                 </div>
                            }
                        </div>
                    </div>

                    <div style="height: 155px; width: 100%;">
                        @if (VM.DynamicsStats.DailyChartLabels.Any())
                        {
                            <MudChart ChartType="ChartType.Line" 
                                      ChartSeries="@(new List<ChartSeries> { 
                                          new ChartSeries { Name = LabelIncome, Data = VM.DynamicsStats.DailyIncomeData },
                                          new ChartSeries { Name = LabelExpense, Data = VM.DynamicsStats.DailyExpenseData } 
                                      })"
                                      XAxisLabels="@VM.DynamicsStats.DailyChartLabels"
                                      Width="100%" Height="100%"
                                      LegendPosition="Position.End"
                                      ChartOptions="@(new ChartOptions { 
                                          ChartPalette = new[] { "#66BB6A", "#EF5350" },
                                          YAxisTicks = 0,
                                          YAxisFormat = "N0"
                                      })" />
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.5);">Нет данных за период</MudText>
                        }
                    </div>
                </div>
            </MudCarouselItem>

            @* СЛАЙД 2: Категории (Pie Chart) *@
            <MudCarouselItem Transition="Transition.Slide">
                <div class="stats-card pa-4">
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: rgba(255,255,255,0.7);">@TitleTopCategories.ToUpper()</MudText>
                     <div style="height: 180px; width: 100%; display: flex; flex-direction: column; justify-content: center; overflow: hidden;">
                         @if (VM.CategoryStats.TopCategories.Any())
                        {
                            //var totalExp = VM.TotalExpense > 0 ? VM.TotalExpense : 1;
                            var colors = new[] { "#F44336", "#2196F3", "#FFC107", "#4CAF50", "#9C27B0" };
                            int i = 0;

                            @foreach (var item in VM.CategoryStats.TopCategories.Take(5))
                            {
                                var percent = item.Percentage;
                                var barWidth = Math.Min(percent, 100); 
                                var color = colors[i % colors.Length];
                                i++;

                                <div class="w-100 mb-2">
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.9); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:70%;">
                                            @item.Name
                                        </MudText>
                                        @if (item.IsExpense)
                                        {
                                            <MudText Typo="Typo.caption" Style="font-weight:700; color: red;">
                                                 -@item.Amount.ToString("N0") (@item.Percentage.ToString("N0")%)
                                            </MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Style="font-weight:700; color: green;">
                                                 +@item.Amount.ToString("N0") (@item.Percentage.ToString("N0")%)
                                            </MudText>
                                        }
                                    </div>
                                    @* Progress Bar Background *@
                                    <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden;">
                                        @* Filled Bar *@
                                        <div style="width: @(barWidth.ToString("F0").Replace(',', '.'))%; height: 100%; background: @color; border-radius: 3px;"></div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                             <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.5); text-align: center; width: 100%;">Нет данных о расходах</MudText>
                        }
                    </div>
                </div>
            </MudCarouselItem>

            @* СЛАЙД 3: Аномалии *@
            <MudCarouselItem Transition="Transition.Slide">
                <div class="stats-card pa-6">
                    <MudText Typo="Typo.subtitle2" Class="mb-4" Style="color: rgba(255,255,255,0.7);">ВЫБРОСЫ (АНАЛИЗ)</MudText>
                    <div class="w-100 px-4">
                         @foreach (var item in VM.CurrentStats.Anomalies.Take(3))
                        {
                            <div class="d-flex justify-space-between align-center mb-2 pa-2 rounded" style="background: rgba(255,255,255,0.1);">
                                <MudText Typo="Typo.caption" Style="color: white; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 60%;">@item.Description</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight:bold; color: #FF8A80;">@item.Sum.ToString("N0")</MudText>
                            </div>
                        }
                        @if (!VM.CurrentStats.Anomalies.Any())
                        {
                             <MudText Typo="Typo.body2" Style="color: white; opacity: 0.7; text-align: center;">Аномальных трат не обнаружено</MudText>
                        }
                    </div>
                </div>
            </MudCarouselItem>

            @* СЛАЙД 4: Сравнение периодов *@
            <MudCarouselItem Transition="Transition.Slide">
                <div class="stats-card pa-6">
                    <MudText Typo="Typo.subtitle2" Class="mb-4" Style="color: rgba(255,255,255,0.7);">СРАВНЕНИЕ С ПРОШЛЫМ ПЕРИОДОМ</MudText>
                    <div class="w-100 px-4 d-flex flex-row gap-4">
                        
                        @* Расходы сравнение *@
                        <div class="pa-3 rounded flex-grow-1" style="background: rgba(255,255,255,0.05);">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7);">РАСХОДЫ</MudText>
                                @{
                                    var expWeight = VM.CurrentStats.ExpenseChangePercent;
                                    var expColor = expWeight > 0 ? "#FF8A80" : "#81C784";
                                    var expSign = expWeight > 0 ? "+" : "";
                                }
                                <MudText Typo="Typo.subtitle2" Style="@($"font-weight:900; color: {expColor};")">
                                    @(expSign + (expWeight * 100).ToString("F1"))%
                                </MudText>
                            </div>
                            <div class="d-flex justify-space-between align-baseline">
                                <MudText Typo="Typo.h5" Style="color: white; font-weight:700;">@VM.CurrentStats.TotalExpense.ToString("N0")</MudText>
                                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.5);">было @VM.CurrentStats.LastMonthTotalExpense.ToString("N0")</MudText>
                            </div>
                        </div>

                        @* Доходы сравнение *@
                        <div class="pa-3 rounded flex-grow-1" style="background: rgba(255,255,255,0.05);">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7);">ДОХОДЫ</MudText>
                                @{
                                    var incWeight = VM.CurrentStats.IncomeChangePercent;
                                    var incColor = incWeight >= 0 ? "#81C784" : "#FF8A80";
                                    var incSign = incWeight > 0 ? "+" : "";
                                }
                                <MudText Typo="Typo.subtitle2" Style="@($"font-weight:900; color: {incColor};")">
                                    @(incSign + (incWeight * 100).ToString("F1"))%
                                </MudText>
                            </div>
                            <div class="d-flex justify-space-between align-baseline">
                                <MudText Typo="Typo.h5" Style="color: white; font-weight:700;">@VM.CurrentStats.TotalIncome.ToString("N0")</MudText>
                                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.5);">было @VM.CurrentStats.LastMonthTotalIncome.ToString("N0")</MudText>
                            </div>
                        </div>

                    </div>
                </div>
            </MudCarouselItem>

            <!-- SLIDE 5: Финансовый Прогноз -->
            <MudCarouselItem Transition="Transition.Slide">
                <div class="stats-card pa-6">
                    <MudText Typo="Typo.subtitle2" Class="mb-4" Style="color: rgba(255,255,255,0.7);">ФИНАНСОВЫЙ ПРОГНОЗ</MudText>
                    
                    <div class="d-flex flex-column align-center w-100 gap-2">
                            <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7);">ТЕКУЩИЙ БАЛАНС</MudText>
                            <MudText Typo="Typo.h4" Style="font-weight:900; color: white;">@VM.PredictionStats.CurrentBalance.ToString("N0")</MudText>
                    </div>

                    <div class="d-flex w-100 justify-space-between px-4 mt-6">
                        <div class="d-flex flex-column align-start">
                                <MudText Typo="Typo.caption" Style="color: #64B5F6;">СЛЕД. ПОСТУПЛЕНИЕ</MudText>
                                <MudText Typo="Typo.body1" Style="color: white; font-weight: bold;">
                                    @(VM.PredictionStats.PredictedIncomeDate?.ToString("dd MMM") ?? "-")
                                </MudText>
                                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.5);">
                                    через @VM.PredictionStats.DaysUntilIncome дн.
                                </MudText>
                        </div>

                        <div class="d-flex flex-column align-end">
                                <MudText Typo="Typo.caption" Style="color: #81C784;">МОЖНО ТРАТИТЬ / ДЕНЬ</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight: bold; color: #81C784;">
                                    @VM.PredictionStats.RecommendedDailyBudget.ToString("N0")
                                </MudText>
                        </div>
                    </div>
                </div>
            </MudCarouselItem>

        </MudCarousel>
    </div>

    @* --- СЛОЙ 2: Скроллящаяся область --- *@
    <div class="scroll-layer" @onscroll="OnScroll" id="scroll-target">
        
        @* Прозрачный блок, через который мы управляем каруселью *@
        <div class="header-spacer">
            <MudSwipeArea OnSwipeEnd="SwipeEndAsync" Class="swipe-catcher" />
            
            @* Кастомные индикаторы (5 точек) *@
            <div class="custom-bullets">
                @for (int i = 0; i < 6; i++)
                {
                    var index = i;
                    <div class="bullet @(selectedIndex == index ? "active" : "")" 
                         @onclick="@(() => SetSlide(index))"></div>
                }
            </div>
        </div>

        <div class="content-sheet">
            <div class="d-flex justify-space-between align-center mb-4 px-2">
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.h6" Style="font-weight: 800; color: #1a1a1a;">@LabelTransactions</MudText>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text">@curentItems.Count()</MudChip>
                </div>
            </div>

            @if (VM.IsFiltred)
            {
                <div class="px-2 mb-4">
                    <MudChip T="string" OnClose="@(() => VM.ClearAdvancedFilters())" Color="Color.Warning" Variant="Variant.Text" Size="Size.Small">
                        Фильтры активны (сбросить)
                    </MudChip>
                </div>
            }

            <div class="transaction-list">
@*                  @if (curentItems == null || !curentItems.Any())
                {
                    <div class="d-flex flex-column align-center justify-center py-10" style="opacity: 0.5;">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mb-2" />
                        <MudText Typo="Typo.body2">Транзакций не найдено</MudText>
                    </div>
                }
                else 
                { *@
                    <Virtualize @ref="_virtualize" ItemsProvider="@LoadServerData" Context="item" OverscanCount="5">
                        <MyTItem @key="item.Id"
                                 TItem="FinanceItem"
                                 Item="@item"
                                 ItemTitle="@item.DisplayTitle"
                                 ItemLabel="@item.DisplayDescription"
                                 infoTitle="@item.FormattedSum"
                                 infoTitleColor="@item.AmountColor"
                                 infoLabel=@($"{item.FormattedTime} · {item.FormattedDate}")
                                 OnItemClick="ItemClicked" />
                    </Virtualize>
@*                 } *@
            </div>
            <div style="height: 100px;"></div>
        </div>
    </div>

    @* Кнопка (Добавить или Вверх) *@
    <div class="fab-container">
        @if (_showScrollToTop)
        {
            <MudFab Color="Color.Secondary" 
                    StartIcon="@Icons.Material.Filled.ArrowUpward" 
                    OnClick="@ScrollToTop"
                    Style="box-shadow: 0 8px 25px rgba(0,0,0,0.2);" />
        }
        else
        {
            <MudFab Color="Color.Primary" 
                    StartIcon="@Icons.Material.Filled.Add" 
                    OnClick="@AddItem"
                    Style="box-shadow: 0 8px 25px rgba(25, 118, 210, 0.4);" />
        }
    </div>

     @* --- СЛОЙ 3: Нижняя навигация (Иконки как в оригинале) --- *@
    <div class="bottom-nav">
        <MudIconButton Icon="@Icons.Material.Filled.List" Color="@(activeTabIndex == 0 ? Color.Primary : Color.Default)" OnClick="@(() => TabChangedAsync(0))" />
        <MudIconButton Icon="@Icons.Material.Filled.Payment" Color="@(activeTabIndex == 1 ? Color.Primary : Color.Default)" OnClick="@(() => TabChangedAsync(1))" />
        <MudIconButton Icon="@Icons.Material.Filled.AccountBalance" Color="@(activeTabIndex == 2 ? Color.Primary : Color.Default)" OnClick="@(() => TabChangedAsync(2))" />
        <MudIconButton Icon="@Icons.Material.Filled.AttachMoney" Color="@(activeTabIndex == 3 ? Color.Primary : Color.Default)" OnClick="@(() => TabChangedAsync(3))" />
        <MudIconButton Icon="@Icons.Material.Filled.QuestionMark" Color="@(activeTabIndex == 4 ? Color.Primary : Color.Default)" OnClick="@(() => TabChangedAsync(4))" />
    </div>



</div>

@implements IDisposable

@code {
    private int selectedIndex = 0;
    private int activeTabIndex = 0;
    private bool _showScrollToTop = false;
    private ICollection<FinanceItem> curentItems = new List<FinanceItem>();
    private Virtualize<FinanceItem> _virtualize;
    
    private string TitleNetBalance => L10n.TitleNetBalance;
    private string LabelIncome => L10n.LabelIncome;
    private string LabelExpense => L10n.LabelExpense;
    private string LabelPerDay => L10n.LabelPerDay;
    private string TitleTopCategories => L10n.TitleTopCategories;
    private string LabelTransactions => L10n.LabelTransactions;

    protected override async Task OnInitializedAsync()
    {
        VM.DataUpdated += HandleDataUpdated;
        VM.DataFiltred += HandleDataFiltred;
        
        await VM.InitializeAsync();
        // Мы больше не загружаем весь список при старте, MudVirtualize сделает это сам через Провайдер
        // Загружаем данные в память для работы статистики (и фильтров)
        await VM.LoadFinanceItemsAsync(); 
        await TabChangedAsync(0);
    }

    private async ValueTask<ItemsProviderResult<FinanceItem>> LoadServerData(ItemsProviderRequest request)
    {
        var filterType = GetFilterType();
        return await VM.GetFinanceItemsProvider(request, filterType);
    }

    private OperacionTyps GetFilterType()
    {
        return activeTabIndex switch
        {
            1 => OperacionTyps.OPLATA,
            2 => OperacionTyps.NALICHNYE,
            3 => OperacionTyps.ZACHISLENIE,
            4 => OperacionTyps.UNREACHABLE,
            _ => OperacionTyps.None
        };
    }

    private async void HandleDataUpdated(object? sender, EventArgs e)
    {
        try
        {
            // Обновляем статистику в памяти
            curentItems = GetActiveItems().ToList();
            if (_virtualize != null)
            {
                await _virtualize.RefreshDataAsync();
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception) { /* Ignore disposal errors */ }
    }

    private async void HandleDataFiltred(object? sender, EventArgs e)
    {
        try
        {
            await FilterChangedAsync();
        }
        catch (Exception) { /* Ignore disposal errors */ }
    }

    public void Dispose()
    {
        VM.DataUpdated -= HandleDataUpdated;
        VM.DataFiltred -= HandleDataFiltred;
    }

    private void SetSlide(int index)
    {
        selectedIndex = index;
        _ = JSRuntime.InvokeVoidAsync("window.dispatchEvent", new { type = "resize" });
    }

    private void SwipeEndAsync(SwipeEventArgs args)
    {
        if (args.SwipeDirection == SwipeDirection.RightToLeft)
        {
            if (selectedIndex < 5) selectedIndex++; // Теперь 5 - это максимальный индекс (6 слайдов)
        }
        else if (args.SwipeDirection == SwipeDirection.LeftToRight)
        {
            if (selectedIndex > 0) selectedIndex--;
        }
        SetSlide(selectedIndex);
    }

    private async Task TabChangedAsync(int index)
    {
        activeTabIndex = index;
        // Вызываем GetActiveItems для обновления статистики (в памяти)
        curentItems = GetActiveItems().ToList();
        // Обновляем виртуализированный список
        if (_virtualize != null)
        {
            await _virtualize.RefreshDataAsync();
        }
        await InvokeAsync(StateHasChanged);
    }
    private async Task FilterChangedAsync()
    {
        // Вызываем GetActiveItems для обновления статистики (в памяти) и кэша в MainViewModel
        curentItems = GetActiveItems().ToList();
        
        if (_virtualize != null)
        {
            await _virtualize.RefreshDataAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    private IEnumerable<FinanceItem> GetActiveItems()
    {
        return activeTabIndex switch
        {
            0 => VM.GetFilteredItems(OperacionTyps.None),
            1 => VM.GetFilteredItems(OperacionTyps.OPLATA),
            2 => VM.GetFilteredItems(OperacionTyps.NALICHNYE),
            3 => VM.GetFilteredItems(OperacionTyps.ZACHISLENIE),
            4 => VM.GetFilteredItems(OperacionTyps.UNREACHABLE),
            _ => Enumerable.Empty<FinanceItem>()
        };
    }

    private async Task ItemClicked(FinanceItem item)
    {
        var parameters = new DialogParameters<FullScreenFinItemDialog> { { x => x.Item, item.ThisFinanceItem }, { x => x.VM, VM } };
        await DialogService.ShowAsync<FullScreenFinItemDialog>("Details", parameters, new DialogOptions { FullScreen = true });
    }

    private async Task AddItem()
    {
        var newItem = new FinanceItem 
        { 
            Date = DateTime.Now, 
            OperationType = OperacionTyps.OPLATA,
            Sum = 0
        };
        var parameters = new DialogParameters<FullScreenFinItemDialog> { { x => x.Item, newItem }, { x => x.VM, VM } };
        await DialogService.ShowAsync<FullScreenFinItemDialog>("Новая операция", parameters, new DialogOptions { FullScreen = true });
    }



    private async Task RefreshAll()
    {
        await VM.LoadFinanceItemsAsync();
        if (_virtualize != null)
        {
            await _virtualize.RefreshDataAsync();
        }
        //await TabChangedAsync(activeTabIndex);
        await InvokeAsync(StateHasChanged);
    }

    private void OnScroll(EventArgs e)
    {
        // В Blazor Server/WASM для получения точного scrollTop эффективнее JS,
        // но для простоты добавим JS-хелпер или будем использовать базовое событие
        _ = CheckScrollPosition();
    }

    private async Task CheckScrollPosition()
    {
        var scrollInfo = await JSRuntime.InvokeAsync<decimal>("eval", "document.getElementById('scroll-target').scrollTop");
        bool shouldShow = scrollInfo > 300;
        if (shouldShow != _showScrollToTop)
        {
            _showScrollToTop = shouldShow;
            StateHasChanged();
        }
    }

    private async Task ScrollToTop()
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('scroll-target').scrollTo({top: 0, behavior: 'smooth'})");
    }
}


