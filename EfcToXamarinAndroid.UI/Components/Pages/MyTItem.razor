@typeparam TItem
<div class="transaction-item @(IsSelected ? "selected" : "")" 
     @onclick="HandleClick"
     @onpointerdown="StartLongPress"
     @onpointerup="CancelLongPress"
     @onpointerleave="CancelLongPress">
    <div class="icon-container @GetIconContainerClass()">
        @if (IsSelected)
        {
            @* Checkmark icon when selected *@
            <svg class="item-icon" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        }
        else if (infoTitleColor == "green")
        {
            <svg class="item-icon" viewBox="0 0 24 24"><path d="M19 15l-1.41-1.41L13 18.17V2h-2v16.17l-4.59-4.58L5 15l7 7 7-7z"/></svg>
        }
        else
        {
            <svg class="item-icon" viewBox="0 0 24 24"><path d="M5 9l1.41 1.41L11 5.83V22h2V5.83l4.59 4.58L19 9l-7-7-7 7z"/></svg>
        }
    </div>

    <div class="content-body">
        <div class="row-1">
            <p class="item-title">@ItemTitle</p>
            <p class="date-text">@infoLabel</p>
        </div>

        <div class="row-2">
            <p class="item-subtitle">@ItemLabel</p>
            <div class="d-flex align-center gap-1">
                @if (Item is EfcToXamarinAndroid.UI.Components.Models.FinanceItem finItem && !string.IsNullOrEmpty(finItem.PendingQrCode))
                {
                    <span @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.QrCode" 
                                       Color="Color.Warning" 
                                       Size="Size.Small" 
                                       OnClick="() => OnRetryReceipt.InvokeAsync(Item)" 
                                       Style="padding: 0; transform: scale(0.8);"
                                       Title="Есть сохраненный QR-код. Нажмите, чтобы проверить чек." />
                    </span>
                }
                <p class="amount-text @(infoTitleColor == "green" ? "income" : "expense")">@infoTitle</p>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public string ItemTitle { get; set; } = string.Empty;
    [Parameter] public string ItemLabel { get; set; } = string.Empty;
    [Parameter] public string infoTitle { get; set; } = string.Empty;
    [Parameter] public string infoTitleColor { get; set; } = string.Empty;
    [Parameter] public string infoLabel { get; set; } = string.Empty;
    [Parameter] public TItem Item { get; set; }
    [Parameter] public EventCallback<TItem> OnItemClick { get; set; }
    [Parameter] public EventCallback<TItem> OnRetryReceipt { get; set; }
    
    // Selection mode parameters
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public bool IsSelectionMode { get; set; }
    [Parameter] public EventCallback<TItem> OnLongPress { get; set; }
    [Parameter] public EventCallback<TItem> OnSelectionToggle { get; set; }
    
    // Long press detection
    private System.Threading.Timer? _longPressTimer;
    private const int LongPressDelayMs = 500;
    private bool _wasLongPress = false;
    
    private void StartLongPress()
    {
        _wasLongPress = false;
        _longPressTimer?.Dispose();
        _longPressTimer = new System.Threading.Timer(async _ =>
        {
            _longPressTimer?.Dispose();
            _longPressTimer = null;
            _wasLongPress = true;
            await InvokeAsync(() => OnLongPress.InvokeAsync(Item));
        }, null, LongPressDelayMs, System.Threading.Timeout.Infinite);
    }
    
    private void CancelLongPress()
    {
        _longPressTimer?.Dispose();
        _longPressTimer = null;
    }
    
    private async Task HandleClick()
    {
        CancelLongPress();
        
        // If long press already fired, don't handle as click
        if (_wasLongPress)
        {
            _wasLongPress = false;
            return;
        }
        
        if (IsSelectionMode)
        {
            await OnSelectionToggle.InvokeAsync(Item);
        }
        else
        {
            await OnItemClick.InvokeAsync(Item);
        }
    }
    
    private string GetIconContainerClass()
    {
        if (IsSelected) return "selected";
        return infoTitleColor == "green" ? "income" : "expense";
    }
    
    // 🚀 ShouldRender оптимизация
    private string? _prevTitle;
    private string? _prevSum;
    private string? _prevLabel;
    private string? _prevPendingQr;
    private bool _prevIsSelected;
    
    protected override bool ShouldRender()
    {
        var currentPendingQr = (Item as EfcToXamarinAndroid.UI.Components.Models.FinanceItem)?.PendingQrCode;
        var changed = _prevTitle != ItemTitle || 
                      _prevSum != infoTitle || 
                      _prevLabel != infoLabel ||
                      _prevPendingQr != currentPendingQr ||
                      _prevIsSelected != IsSelected;
        
        if (changed)
        {
            _prevTitle = ItemTitle;
            _prevSum = infoTitle;
            _prevLabel = infoLabel;
            _prevPendingQr = currentPendingQr;
            _prevIsSelected = IsSelected;
        }
        
        return changed;
    }
}

