@page "/qr-config"
@using EfcToXamarinAndroid.Core.Configs.ManagerCore
@using EfcToXamarinAndroid.Core.ViewModels

@inject MainViewModel ViewModel
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudText Typo="Typo.h5" Class="mb-4">Настройки QR-кодов</MudText>
    
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Конфигурация по умолчанию</MudText>
        <MudSelect T="string" 
                   Label="Провайдер проверки чеков" 
                   @bind-Value="_selectedDefaultName"
                   Variant="Variant.Outlined">
            @foreach (var config in _configurations.Where(c => c.ApiConfig != null))
            {
                <MudSelectItem Value="@config.Name">@config.Name</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   Class="mt-2"
                   OnClick="SetDefaultConfiguration">
            Сохранить
        </MudButton>
    </MudPaper>
    
    <MudText Typo="Typo.h6" Class="mb-2">Все конфигурации</MudText>
    
    <MudTable Items="_configurations" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>Название</MudTh>
            <MudTh>Тип</MudTh>
            <MudTh>Статус</MudTh>
            <MudTh>Действия</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Название">
                @context.Name
                @if (context.IsDefault)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-2">По умолчанию</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Тип">
                @GetConfigType(context)
            </MudTd>
            <MudTd DataLabel="Статус">
                <MudSwitch T="bool" Value="context.IsActive" ValueChanged="(val) => ToggleActive(context, val)" Color="Color.Success" />
            </MudTd>
            <MudTd DataLabel="Действия">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                               Size="Size.Small" 
                               OnClick="() => EditConfiguration(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" 
                               Size="Size.Small" 
                               OnClick="() => DuplicateConfiguration(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                               Size="Size.Small" 
                               Color="Color.Error"
                               OnClick="() => DeleteConfiguration(context)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
    
    <MudButton Variant="Variant.Outlined" 
               Color="Color.Primary" 
               StartIcon="@Icons.Material.Filled.Add"
               Class="mt-4"
               OnClick="AddNewConfiguration">
        Добавить конфигурацию
    </MudButton>
</MudContainer>

@code {
    private List<ReceiptConfiguration> _configurations = new();
    private string _selectedDefaultName = "";
    
    protected override void OnInitialized()
    {
        LoadConfigurations();
    }
    
    private void LoadConfigurations()
    {
        var configManager = ConfigurationManager.ConfigManager;
        _configurations = configManager.BankConfigurationFromJson?.ReceiptConfigurations ?? new();
        
        var defaultConfig = _configurations.FirstOrDefault(c => c.IsDefault);
        _selectedDefaultName = defaultConfig?.Name ?? "";
    }
    
    private string GetConfigType(ReceiptConfiguration config)
    {
        if (config.ApiConfig != null) return "QR-код (API)";
        if (!string.IsNullOrEmpty(config.SenderEmail)) return "Email";
        if (!string.IsNullOrEmpty(config.UrlPattern)) return "URL";
        return "Другое";
    }
    
    private void SetDefaultConfiguration()
    {
        foreach (var config in _configurations)
        {
            config.IsDefault = config.Name == _selectedDefaultName;
        }
        SaveConfigurations();
        Snackbar.Add("Конфигурация по умолчанию сохранена", Severity.Success);
    }
    
    private void SaveConfigurations()
    {
        var configManager = ConfigurationManager.ConfigManager;
        configManager.Save();
    }
    
    private void ToggleActive(ReceiptConfiguration config, bool value)
    {
        config.IsActive = value;
        SaveConfigurations();
    }
    
