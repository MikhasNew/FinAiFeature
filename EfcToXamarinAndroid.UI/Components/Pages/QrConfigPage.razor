    private async Task DeleteConfiguration(ReceiptConfiguration config)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Удаление",
            $"Удалить конфигурацию '{config.Name}'?",
            yesText: "Удалить",
            cancelText: "Отмена");
            
        if (confirmed == true)
        {
            _configurations.Remove(config);
            SaveConfigurations();
            Snackbar.Add("Конфигурация удалена", Severity.Info);
        }
    }
    
    private void DuplicateConfiguration(ReceiptConfiguration config)
    {
        var newConfig = new ReceiptConfiguration
        {
            Name = config.Name + " (копия)",
            IsActive = false,
            IsDefault = false,
            QrCodePattern = config.QrCodePattern,
            SenderEmail = config.SenderEmail,
            UrlPattern = config.UrlPattern,
            ApiConfig = config.ApiConfig != null ? new ReceiptApiConfig
            {
                Url = config.ApiConfig.Url,
                Method = config.ApiConfig.Method,
                ContentType = config.ApiConfig.ContentType,
                DateFormat = config.ApiConfig.DateFormat,
                ParameterMapping = config.ApiConfig.ParameterMapping != null 
                    ? new Dictionary<string, string>(config.ApiConfig.ParameterMapping) 
                    : new Dictionary<string, string>()
            } : null,
            JsonPaths = config.JsonPaths != null ? new ReceiptJsonPaths
            {
                StatusPath = config.JsonPaths.StatusPath,
                SuccessValue = config.JsonPaths.SuccessValue,
                TotalSum = config.JsonPaths.TotalSum,
                ShopName = config.JsonPaths.ShopName,
                ShopInn = config.JsonPaths.ShopInn,
                Currency = config.JsonPaths.Currency,
                ReceiptDate = config.JsonPaths.ReceiptDate,
                DateFormat = config.JsonPaths.DateFormat,
                Address = config.JsonPaths.Address,
                AddressTemplate = config.JsonPaths.AddressTemplate,
                ItemsArray = config.JsonPaths.ItemsArray,
                ItemName = config.JsonPaths.ItemName,
                ItemQuantity = config.JsonPaths.ItemQuantity,
                ItemAmount = config.JsonPaths.ItemAmount,
                ItemPrice = config.JsonPaths.ItemPrice
            } : null
        };
        
        _configurations.Add(newConfig);
        SaveConfigurations();
        Snackbar.Add("Конфигурация скопирована", Severity.Success);
    }
    
