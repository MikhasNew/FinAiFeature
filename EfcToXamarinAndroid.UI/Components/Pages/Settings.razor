@page "/settings"
@using EfcToXamarinAndroid.Core.Configs.ManagerCore
@using EfcToXamarinAndroid.Core.Enums

<MudContainer Class="pa-4">
    <MudText Typo="Typo.h5">Настройки</MudText>

    <MudSelect T="DisplayPeriod" Label="Период отображения по умолчанию" @bind-Value="Config.DefaultPeriod" Class="mt-4">
        @foreach (DisplayPeriod item in Enum.GetValues(typeof(DisplayPeriod)))
        {
            <MudSelectItem Value="@item">@GetDescription(item)</MudSelectItem>
        }
    </MudSelect>

    <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled" Class="mt-4">Сохранить</MudButton>

    <MudDivider Class="my-4"/>

    <MudText Typo="Typo.h5" Class="mt-4">Настройки Email (для чеков)</MudText>
    <MudPaper Class="pa-4 mt-2">
        <MudTextField Label="Email адрес" @bind-Value="Config.EmailSettings.Email" Variant="Variant.Outlined" Class="mb-4" />

        <MudStack Row="true" Class="mb-4">
            <MudTextField Label="IMAP Хост" @bind-Value="Config.EmailSettings.ImapHost" Placeholder="imap.gmail.com" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudNumericField Label="Порт" @bind-Value="Config.EmailSettings.ImapPort" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 100px;" />
        </MudStack>

        <MudSwitch Label="Использовать OAuth2 (Google)" Value="Config.EmailSettings.UseOAuth" ValueChanged="OnOAuthChanged" T="bool" Color="Color.Primary" Class="my-3"/>
        
        @if (Config.EmailSettings.UseOAuth)
        {
              <MudStack Row="true" Class="mt-2">
                  <MudTextField @bind-Value="Config.EmailSettings.ClientId" Label="Client ID" Variant="Variant.Outlined" Margin="Margin.Dense" 
                               HelperText="Оставьте пустым для встроенного конфига" />
                  <MudTextField @bind-Value="Config.EmailSettings.ClientSecret" Label="Client Secret" Variant="Variant.Outlined" Margin="Margin.Dense" 
                               InputType="InputType.Password" HelperText="Оставьте пустым для встроенного конфига" />
              </MudStack>
              
              <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4">
                  <MudButton OnClick="SignInGoogle" Variant="Variant.Filled" StartIcon="@Icons.Custom.Brands.Google" Color="Color.Error">Войти через Google</MudButton>
                  @if (!string.IsNullOrEmpty(Config.EmailSettings.AccessToken))
                  {
                      <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.Check">Токен получен</MudChip>
                      @if (Config.EmailSettings.TokenExpiry.HasValue)
                      {
                          var isExpiringSoon = Config.EmailSettings.TokenExpiry.Value < DateTime.Now.AddDays(1);
                          var isExpired = Config.EmailSettings.TokenExpiry.Value < DateTime.Now;
                          <MudChip T="string" 
                                   Color="@(isExpired ? Color.Error : isExpiringSoon ? Color.Warning : Color.Default)" 
                                   Size="Size.Small"
                                   Icon="@(isExpired ? Icons.Material.Filled.Error : Icons.Material.Filled.Schedule)">
                              @(isExpired ? "Истёк" : $"До: {Config.EmailSettings.TokenExpiry.Value:dd.MM HH:mm}")
                          </MudChip>
                      }
                  }
              </MudStack>
             
             <MudTextField Label="Access Token (Debug)" @bind-Value="Config.EmailSettings.AccessToken" ReadOnly="true" Variant="Variant.Text" Class="mt-2"/>
        }
        else
        {
             <MudTextField Label="Пароль (App Password)" @bind-Value="Config.EmailSettings.Password" InputType="InputType.Password" />
        }

        <MudCheckBox Label="Использовать SSL" @bind-Value="Config.EmailSettings.UseSsl" Color="Color.Primary" />
        
        <MudText Typo="Typo.subtitle2" Class="mt-2">Фильтры</MudText>
        <MudTextField Label="Папка (по умолчанию INBOX)" @bind-Value="Config.EmailSettings.FolderToScan" />
        <MudTextField Label="Фильтр по отправителю" @bind-Value="Config.EmailSettings.SenderFilter" HelperText="Например: receipts@ofd.ru" />
        
        @if (_isSyncing)
        {
            <MudPaper Elevation="0" Class="pa-3 my-2" Style="background: var(--mud-palette-background-grey);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2">@_syncStatus</MudText>
                </MudStack>
                <MudProgressLinear Indeterminate="true" Color="Color.Success" Class="mt-2" />
            </MudPaper>
        }

        <MudStack Row="true" Class="mt-4">
            <MudButton OnClick="TestConnection" Variant="Variant.Outlined" Color="Color.Secondary" Disabled="_isSyncing">Проверить соединение</MudButton>
            <MudButton OnClick="SyncReceipts" Variant="Variant.Filled" Color="Color.Success" Disabled="_isSyncing">Синхронизировать чеки</MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    [Inject] private EfcToXamarinAndroid.Core.Services.IEmailService EmailService { get; set; }
    [Inject] private EfcToXamarinAndroid.Core.Services.OAuthService OAuthService { get; set; }
    [Inject] private NavigationManager Navigation { get; set; }
    [Inject] private ISnackbar Snackbar { get; set; }
    
    private AppConfiguration Config => ConfigurationManager.ConfigManager.BankConfigurationFromJson;
    private bool _isSyncing = false;
    private string _syncStatus = "Подключение к серверу...";

    private void Save() => ConfigurationManager.ConfigManager.Save();

    private void OnOAuthChanged(bool useOAuth)
    {
        Config.EmailSettings.UseOAuth = useOAuth;
        if (useOAuth && string.IsNullOrEmpty(Config.EmailSettings.ImapHost))
        {
            Config.EmailSettings.ImapHost = "imap.gmail.com";
            Config.EmailSettings.ImapPort = 993;
            Config.EmailSettings.UseSsl = true;
        }
    }

    private void SignInGoogle()
    {
        // Prefer settings if entered manually, else use loaded from file
        var clientId = !string.IsNullOrEmpty(Config.EmailSettings.ClientId) ? Config.EmailSettings.ClientId : EfcToXamarinAndroid.Core.Configs.GoogleAuthConfig.Default.ClientId;
        
        if (string.IsNullOrEmpty(clientId) || clientId == "YOUR_CLIENT_ID_HERE")
        {
             Snackbar.Add("Ошибка: Client ID не настроен (проверьте google_secrets.json или введите в поле выше)", Severity.Error);
             return;
        }

        // Determine Redirect URI
        var callbackPath = "oauth-callback";
        var baseUri = Navigation.BaseUri;
        var redirectUri = baseUri + callbackPath;

        var authUrl = OAuthService.GenerateAuthUrl(clientId, redirectUri);
        
        // Save current state just in case
        Save();
        
        // Navigate
        Navigation.NavigateTo(authUrl);
    }

    private async Task TestConnection()
    {
        try
        {
            bool success = await EmailService.TestConnectionAsync();
            if (success)
                Snackbar.Add("Соединение успешно!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SyncReceipts()
    {
        _isSyncing = true;
        _syncStatus = "Подключение к серверу...";
        StateHasChanged();
        
        try
        {
            _syncStatus = "Получение списка писем...";
            StateHasChanged();
            await Task.Delay(100); // Allow UI to update
            
            await EmailService.SyncReceiptsAsync();
            
            _syncStatus = "Готово!";
            Snackbar.Add("Синхронизация завершена!", Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Settings] Sync Error: {ex}");
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSyncing = false;
            StateHasChanged();
        }
    }

    private string GetDescription(DisplayPeriod val)
    {
        var field = val.GetType().GetField(val.ToString());
        var attributes = (System.ComponentModel.DescriptionAttribute[])field.GetCustomAttributes(typeof(System.ComponentModel.DescriptionAttribute), false);
        return attributes.Length > 0 ? attributes[0].Description : val.ToString();
    }
}