@page "/settings"
@using EfcToXamarinAndroid.Core.Configs.ManagerCore
@using EfcToXamarinAndroid.Core.Enums
@using Microsoft.Extensions.DependencyInjection

@* Gradient Header *@
<div class="settings-page-header">
    <MudText Typo="Typo.h5" Style="color: white; font-weight: 700;">Настройки</MudText>
    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7);">Персонализация приложения</MudText>
</div>

@* Content Sheet *@
<div class="settings-content-sheet">
    
    @* General Settings Section *@
    <div class="settings-section">
        <div class="settings-section-title">
            <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Общие настройки</MudText>
            <MudSpacer />
            <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">Сохранить</MudButton>
        </div>
        
        <MudSelect T="DisplayPeriod" Label="Период отображения по умолчанию" @bind-Value="Config.DefaultPeriod" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
            @foreach (DisplayPeriod item in Enum.GetValues(typeof(DisplayPeriod)))
            {
                <MudSelectItem Value="@item">@GetDescription(item)</MudSelectItem>
            }
        </MudSelect>
    </div>

    @* Email Settings Section *@
    <div class="settings-section">
        <div class="settings-section-title">
            <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Info" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Email для чеков</MudText>
        </div>
        
        <MudTextField Label="Email адрес" @bind-Value="Config.EmailSettings.Email" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" sm="9">
                <MudTextField Label="IMAP Хост" @bind-Value="Config.EmailSettings.ImapHost" Placeholder="imap.gmail.com" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField Label="Порт" @bind-Value="Config.EmailSettings.ImapPort" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>

        <MudSwitch Label="Использовать OAuth2" Value="Config.EmailSettings.UseOAuth" ValueChanged="OnOAuthChanged" T="bool" Color="Color.Primary" Class="my-2"/>
        
        @if (Config.EmailSettings.UseOAuth)
        {
            <MudSelect T="string" Label="OAuth Провайдер" Value="Config.EmailSettings.OAuthProvider" ValueChanged="OnProviderChanged" 
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                <MudSelectItem Value="@("Google")">Google</MudSelectItem>
                <MudSelectItem Value="@("Yandex")">Яндекс</MudSelectItem>
            </MudSelect>
        }
        
        @if (Config.EmailSettings.UseOAuth)
        {
            <MudGrid Spacing="2" Class="mt-2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Config.EmailSettings.ClientId" Label="Client ID" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                 HelperText="Оставьте пустым для встроенного" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Config.EmailSettings.ClientSecret" Label="Client Secret" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                 InputType="InputType.Password" HelperText="Оставьте пустым для встроенного" />
                </MudItem>
            </MudGrid>
            
            <MudGrid Spacing="2" Class="mt-3">
                <MudItem xs="12" sm="6">
                    <MudButton OnClick="SignInOAuth" Variant="Variant.Filled" StartIcon="@GetProviderIcon()" Color="@GetProviderColor()" Size="Size.Small" FullWidth="true">Войти через @Config.EmailSettings.OAuthProvider</MudButton>
                </MudItem>
                @if (!string.IsNullOrEmpty(Config.EmailSettings.AccessToken))
                {
                    <MudItem xs="6" sm="3">
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Check">Токен OK</MudChip>
                    </MudItem>
                    @if (Config.EmailSettings.TokenExpiry.HasValue)
                    {
                        var isExpiringSoon = Config.EmailSettings.TokenExpiry.Value < DateTime.Now.AddDays(1);
                        var isExpired = Config.EmailSettings.TokenExpiry.Value < DateTime.Now;
                        <MudItem xs="6" sm="3">
                            <MudChip T="string" 
                                     Color="@(isExpired ? Color.Error : isExpiringSoon ? Color.Warning : Color.Default)" 
                                     Size="Size.Small"
                                     Icon="@(isExpired ? Icons.Material.Filled.Error : Icons.Material.Filled.Schedule)">
                                @(isExpired ? "Истёк" : $"До: {Config.EmailSettings.TokenExpiry.Value:dd.MM HH:mm}")
                            </MudChip>
                        </MudItem>
                    }
                }
            </MudGrid>
        }
        else
        {
            <MudTextField Label="Пароль (App Password)" @bind-Value="Config.EmailSettings.Password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
        }

        <MudCheckBox Label="Использовать SSL" @bind-Value="Config.EmailSettings.UseSsl" Color="Color.Primary" Dense="true" Class="mt-2" />
        
        <MudDivider Class="my-3" />
        
        <MudText Typo="Typo.caption" Style="font-weight: 600; opacity: 0.7;" Class="mb-2">ФИЛЬТРЫ</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField Label="Папка" @bind-Value="Config.EmailSettings.FolderToScan" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="INBOX" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Label="Фильтр по отправителю" @bind-Value="Config.EmailSettings.SenderFilter" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="receipts@ofd.ru" />
            </MudItem>
        </MudGrid>
        
        @if (_isSyncing)
        {
            <MudPaper Elevation="0" Class="pa-3 mt-3 rounded-lg" Style="background: var(--mud-palette-background-grey);">
                <div class="d-flex align-center gap-2">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2">@_syncStatus</MudText>
                </div>
                <MudProgressLinear Indeterminate="true" Color="Color.Success" Class="mt-2" />
            </MudPaper>
        }

        <MudGrid Spacing="2" Class="mt-4">
            <MudItem xs="12" sm="6">
                <MudButton OnClick="TestConnection" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="_isSyncing" FullWidth="true" StartIcon="@Icons.Material.Filled.Wifi">Проверить</MudButton>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudButton OnClick="SyncReceipts" Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" Disabled="_isSyncing" FullWidth="true" StartIcon="@Icons.Material.Filled.Sync">Синхронизировать</MudButton>
            </MudItem>
        </MudGrid>
    </div>
</div>

@code {
    [Inject] private EfcToXamarinAndroid.Core.Services.IEmailService EmailService { get; set; }
    [Inject] private EfcToXamarinAndroid.Core.Services.OAuthService OAuthService { get; set; }
    [Inject] private NavigationManager Navigation { get; set; }
    [Inject] private ISnackbar Snackbar { get; set; }
    [Inject] private IServiceProvider Services { get; set; }
    
    private AppConfiguration Config => ConfigurationManager.ConfigManager.BankConfigurationFromJson;
    private bool _isSyncing = false;
    private string _syncStatus = "Подключение к серверу...";

    private void Save() => ConfigurationManager.ConfigManager.Save();

    private void OnOAuthChanged(bool useOAuth)
    {
        Config.EmailSettings.UseOAuth = useOAuth;
        if (useOAuth && string.IsNullOrEmpty(Config.EmailSettings.ImapHost))
        {
            Config.EmailSettings.ImapHost = GetDefaultImapHost();
            Config.EmailSettings.ImapPort = 993;
            Config.EmailSettings.UseSsl = true;
        }
    }

    private void OnProviderChanged(string provider)
    {
        Config.EmailSettings.OAuthProvider = provider;
        Config.EmailSettings.ImapHost = GetDefaultImapHost();
        Config.EmailSettings.ImapPort = 993;
        Config.EmailSettings.UseSsl = true;
        // Сбросить токены при смене провайдера
        Config.EmailSettings.AccessToken = null;
        Config.EmailSettings.RefreshToken = null;
        Config.EmailSettings.TokenExpiry = null;
    }

    private string GetDefaultImapHost() => Config.EmailSettings.OAuthProvider switch
    {
        "Yandex" => "imap.yandex.com",
        _ => "imap.gmail.com"
    };

    private string GetProviderIcon() => Config.EmailSettings.OAuthProvider switch
    {
        "Yandex" => Icons.Material.Filled.Mail,
        _ => Icons.Custom.Brands.Google
    };

    private Color GetProviderColor() => Config.EmailSettings.OAuthProvider switch
    {
        "Yandex" => Color.Warning,
        _ => Color.Error
    };

    private async Task SignInOAuth()
    {
        // Определяем провайдера из настроек
        var providerName = Config.EmailSettings.OAuthProvider ?? "Google";
        
        // Получаем credentials в зависимости от провайдера
        string clientId, clientSecret;
        if (providerName.Equals("Yandex", StringComparison.OrdinalIgnoreCase))
        {
            clientId = !string.IsNullOrEmpty(Config.EmailSettings.ClientId) ? Config.EmailSettings.ClientId : EfcToXamarinAndroid.Core.Configs.YandexAuthConfig.Default.ClientId;
            clientSecret = !string.IsNullOrEmpty(Config.EmailSettings.ClientSecret) ? Config.EmailSettings.ClientSecret : EfcToXamarinAndroid.Core.Configs.YandexAuthConfig.Default.ClientSecret;
        }
        else // Google
        {
            clientId = !string.IsNullOrEmpty(Config.EmailSettings.ClientId) ? Config.EmailSettings.ClientId : EfcToXamarinAndroid.Core.Configs.GoogleAuthConfig.Default.ClientId;
            clientSecret = !string.IsNullOrEmpty(Config.EmailSettings.ClientSecret) ? Config.EmailSettings.ClientSecret : EfcToXamarinAndroid.Core.Configs.GoogleAuthConfig.Default.ClientSecret;
        }
        
        if (string.IsNullOrEmpty(clientId) || clientId == "YOUR_CLIENT_ID_HERE")
        {
             Snackbar.Add($"Ошибка: Client ID для {providerName} не настроен (проверьте {providerName.ToLower()}_secrets.json или введите в поле выше)", Severity.Error);
             return;
        }

        // Try to get Native Authenticator (Maui)
        var authenticator = Services.GetService<EfcToXamarinAndroid.Core.Services.IWebBrowserAuthenticator>();
        
        if (authenticator != null)
        {
            // Native Flow (Android/iOS/WinUI)
            // Use Custom Scheme Callback
            var callbackScheme = "com.companyname.mauiappwithmudblazor";
            // Note: callbackUrl usually needs to be just the scheme or scheme://something
            // WebAuthenticator documentation says: "The callback Url that the app expects to receive"
            // For Android, this filters the intent.
            var callbackUrl = $"{callbackScheme}://callback";
            
            var authUrl = OAuthService.GenerateAuthUrl(providerName, clientId, callbackUrl);
            
            try 
            {
                var result = await authenticator.AuthenticateAsync(new Uri(authUrl), new Uri(callbackUrl));
                if (result != null && result.TryGetValue("code", out var code))
                {
                    // Have code! Exchange it!
                    var tokens = await OAuthService.ExchangeCodeForTokenAsync(providerName, code, clientId, clientSecret, callbackUrl);
                    
                    Config.EmailSettings.AccessToken = tokens.AccessToken;
                    if (!string.IsNullOrEmpty(tokens.RefreshToken))
                    {
                        Config.EmailSettings.RefreshToken = tokens.RefreshToken;
                    }
                    Config.EmailSettings.TokenExpiry = DateTime.Now.AddSeconds(tokens.ExpiresIn);
                    
                    Save();
                    Snackbar.Add($"Успешный вход через {providerName}!", Severity.Success);
                    StateHasChanged();
                }
            }
            catch(Exception ex)
            {
                Snackbar.Add($"Auth Error: {ex.Message}", Severity.Error);
            }
        }
        else
        {
            // Web Flow (Blazor Server / Browser)
            // Determine Redirect URI
            var callbackPath = "oauth-callback";
            var baseUri = Navigation.BaseUri;
            var redirectUri = baseUri + callbackPath;

            var authUrl = OAuthService.GenerateAuthUrl(providerName, clientId, redirectUri);
            
            // Save current state just in case
            Save();
            
            // Navigate
            Navigation.NavigateTo(authUrl);
        }
    }

    private async Task TestConnection()
    {
        try
        {
            bool success = await EmailService.TestConnectionAsync();
            if (success)
                Snackbar.Add("Соединение успешно!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SyncReceipts()
    {
        _isSyncing = true;
        _syncStatus = "Подключение к серверу...";
        StateHasChanged();
        
        try
        {
            _syncStatus = "Получение списка писем...";
            StateHasChanged();
            await Task.Delay(100); // Allow UI to update
            
            await EmailService.SyncReceiptsAsync();
            
            _syncStatus = "Готово!";
            Snackbar.Add("Синхронизация завершена!", Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Settings] Sync Error: {ex}");
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSyncing = false;
            StateHasChanged();
        }
    }

    private string GetDescription(DisplayPeriod val)
    {
        var field = val.GetType().GetField(val.ToString());
        var attributes = (System.ComponentModel.DescriptionAttribute[])field.GetCustomAttributes(typeof(System.ComponentModel.DescriptionAttribute), false);
        return attributes.Length > 0 ? attributes[0].Description : val.ToString();
    }
}