@using EfcToXamarinAndroid.UI.Components.Models
@using EfcToXamarinAndroid.Core.ViewModels
@using EfcToXamarinAndroid.Core.Repository
@using EfcToXamarinAndroid.Core
@inject NavigationManager NavManager
@inject IDialogService DialogService
@inject IQrCodeService QrCodeService
@inject ISnackbar Snackbar
@using EfcToXamarinAndroid.Core.Parsers
@using EfcToXamarinAndroid.UI.Components.Dialogs

<MudContainer Class="align-center" MaxWidth="MaxWidth.ExtraLarge" Style="padding:0px; overflow:auto">
    <MudOverlay Visible="_isLoading" DarkBackground="true" Absolute="true">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudOverlay>
    <MudDialog Style="padding:0px;">
        <TitleContent>
            <MudAppBar Dense="true" Elevation="0">
                <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" Color="Color.Inherit" OnClick="Cancel" />
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.QrCodeScanner" OnClick="ScanQrCode" Color="Color.Inherit" Disabled="_isLoading" />
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" OnClick="Edit" />
                <MudIconButton Icon="@Icons.Material.Outlined.MoreVert" Color="Color.Inherit" />
            </MudAppBar>
        </TitleContent>
        <DialogContent>
            <FinItemPage Item="@Item" VM="@VM" Editable="@IsEditanle" />

            @if (_receipt != null)
            {
                <MudExpansionPanel Text="Детали чека" Class="mt-4">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText Typo="Typo.h6">@_receipt.ShopName</MudText>
                            <MudText Typo="Typo.caption">@_receipt.ReceiptDate.ToString("g")</MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTable Items="@_receipt.Items" Dense="true" Hover="true" Striped="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Товар</MudTh>
                                    <MudTh>Цена</MudTh>
                                    <MudTh>Кол-во</MudTh>
                                    <MudTh>Сумма</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="row">
                                    <MudTd DataLabel="Товар">@row.Name</MudTd>
                                    <MudTd DataLabel="Цена">@row.Price.ToString("N2")</MudTd>
                                    <MudTd DataLabel="Кол-во">@row.Quantity.ToString("G29")</MudTd>
                                    <MudTd DataLabel="Сумма">@row.Sum.ToString("N2")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudItem>
                        <MudItem xs="12" Class="d-flex justify-end">
                            <MudText Typo="Typo.h6">Итого: @_receipt.TotalSum.ToString("N2")</MudText>
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>
            }

        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Отмена</MudButton>
            <MudButton Color="Color.Primary" OnClick="Submit" Disabled="_isLoading">Сохранить</MudButton>
        </DialogActions>
    </MudDialog>
</MudContainer>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    [Parameter]
    public FinanceItem Item { get; set; }
    [Parameter]
    public MainViewModel VM { get; set; }

    bool IsEditanle;
    private Receipt? _receipt;
    private bool _isLoading = false;
    private string? _pendingQrCode; // Сохраняем QR-код, если не удалось загрузить

    private async Task Submit()
    {
        MudDialog.Close(DialogResult.Ok(Item));
        await VM.UpdateItemValueAsync(Item.Id, Item, _receipt, _pendingQrCode);
        NavManager.NavigateTo(NavManager.Uri, replace: true);
    }

    private async Task Cancel()
    {
        MudDialog.Cancel();
        NavManager.NavigateTo(NavManager.Uri, replace: true);
    }

    private void Edit() => IsEditanle = !IsEditanle;

    private async Task ScanQrCode()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<QrScannerDialog>("Сканирование QR", options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is string qrCode)
        {
            _isLoading = true;
            StateHasChanged();
            try
            {
                // 1. Попытка получить чек через конфигурируемый сервис
                // Используем дату из Item как подсказку, если в QR её нет
                var receipt = await QrCodeService.GetReceiptByQrCodeAsync(qrCode, Item.Date);
                if (receipt != null)
                {
                    _receipt = receipt;
                    _pendingQrCode = null;

                    // Обновляем поля из полученного чека
                    if (Item.Id == default) Item.Date = receipt.ReceiptDate;
                    if (Item.Sum == 0) Item.Sum = receipt.TotalSum;
                    if (string.IsNullOrEmpty(Item.Description)) Item.Description = receipt.ShopName;
                    else Item.Description = $"{Item.Description} ({receipt.ShopName})";
                    Snackbar.Add("Чек успешно загружен!", Severity.Success);
                }
                else
                {
                    // 2. Fallback: Старый парсер FNS (если новая конфигурация не сработала)
                    var data = FnsQrParser.Parse(qrCode);
                    if (!string.IsNullOrEmpty(data.TransactionCode))
                    {
                        // Попытка загрузить по коду транзакции (старый метод)
                        var dateToUse = data.Date ?? Item.Date;
                        if (dateToUse == default)
                        {
                            Snackbar.Add("Укажите дату транзакции перед сканированием", Severity.Warning);
                            _pendingQrCode = qrCode;
                        }
                        else
                        {
                            // Этот метод внутри тоже вызывает GetReceiptByQrCodeAsync, но может быть полезен
                            // если логика парсинга строки в сервисе отличается от FnsQrParser
                            receipt = await QrCodeService.GetReceiptByTransactionCodeAsync(dateToUse, data.TransactionCode);
                            if (receipt != null)
                            {
                                _receipt = receipt;
                                _pendingQrCode = null;
                                if (Item.Id == default) Item.Date = receipt.ReceiptDate;
                                if (Item.Sum == 0) Item.Sum = receipt.TotalSum;

                                if (string.IsNullOrEmpty(Item.Description))
                                    Item.Description = receipt.ShopName;
                                else
                                    Item.Description = $"{Item.Description} ({receipt.ShopName}) ";
                                Snackbar.Add("Чек успешно загружен (Legacy)!", Severity.Success);
                            }
                            else
                            {
                                Snackbar.Add("Чек не найден (код транзакции извлечен, но API вернул пустоту).", Severity.Warning);
                                _pendingQrCode = qrCode;
                            }
                        }
                    }
                    else
                    {
                        // 3. Если ничего не помогло - просто извлекаем дату/сумму если можем
                        if (data.Date.HasValue || data.Sum.HasValue)
                        {
                            if (data.Date.HasValue) Item.Date = data.Date.Value;
                            if (data.Sum.HasValue) Item.Sum = data.Sum.Value;
                            Snackbar.Add("Данные из QR-кода применены (Чек не найден)", Severity.Info);
                        }
                        else
                        {
                            Snackbar.Add("Не удалось распознать QR-код ни одной конфигурацией.", Severity.Error);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Ошибка при обработке QR: {ex.Message}", Severity.Error);
                _pendingQrCode = qrCode;
            }
            finally
            {
                _isLoading = false;
                IsEditanle = true;
                StateHasChanged();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (Item?.Id != null && Item.Id != 0)
        {
            _receipt = await DatesRepositorio.GetReceiptByDataItemIdAsync(Item.Id);
        }
    }

    public void Dispose()
    {
        VM.Dispose();
    }
}
