@page "/rules"
@using EfcToXamarinAndroid.Core.Configs.ManagerCore
@using EfcToXamarinAndroid.Core
@using EfcToXamarinAndroid.UI.Components.Dialogs
@using Newtonsoft.Json
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Gradient Header *@
<div class="rules-page-header">
    <MudText Typo="Typo.h5" Style="color: white; font-weight: 700;">Правила парсинга SMS</MudText>
    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7);">Настройте обработку банковских SMS</MudText>
</div>

@* Content Sheet *@
<div class="rules-content-sheet">
    <MudGrid Class="mb-4" Spacing="2">
        <MudItem xs="12" sm="6" Class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Sms" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Color="Color.Primary">Банки (@(_banks?.Count ?? 0))</MudText>
        </MudItem>
        <MudItem xs="12" sm="6" Class="d-flex justify-start justify-sm-end">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add" 
                       OnClick="AddBank">
                Добавить банк
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (_banks == null || !_banks.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="rounded-lg">
            <MudText Typo="Typo.body2">Конфигурации банков не найдены.</MudText>
            <MudText Typo="Typo.caption" Style="opacity: 0.7;">Добавьте первую конфигурацию для автоматической обработки SMS.</MudText>
        </MudAlert>
    }
    else
    {
        <MudTable Items="@_banks" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Dense="false" Class="mb-4 rounded-lg" Style="border: 1px solid var(--mud-palette-divider);">
            <HeaderContent>
                <MudTh>Название банка</MudTh>
                <MudTh>Отправитель (SMS ID)</MudTh>
                <MudTh Style="width: 140px; text-align: center;">Действия</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Название">
                    <MudText Typo="Typo.body1" Style="font-weight: 500;">@context.Name</MudText>
                </MudTd>
                <MudTd DataLabel="Отправитель">
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">@context.SmsNumber</MudChip>
                </MudTd>
                <MudTd Style="text-align: center;">
                    <div class="d-flex justify-center gap-1">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" 
                                       Color="Color.Primary" 
                                       OnClick="@(() => EditBank(context))" 
                                       Size="Size.Small" />
                        <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" 
                                       Color="Color.Default" 
                                       OnClick="@(() => DuplicateBank(context))" 
                                       Size="Size.Small" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" 
                                       Color="Color.Error" 
                                       OnClick="@(() => DeleteBank(context))" 
                                       Size="Size.Small" />
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="Всего {all_items}" RowsPerPageString="Рядов:" />
            </PagerContent>
        </MudTable>
    }

    <MudExpansionPanels MultiExpansion="true" Class="mt-4" Elevation="0">
        <MudExpansionPanel Text="Как это работает?" Style="border: 1px solid var(--mud-palette-divider); border-radius: 12px;">
            <MudText Typo="Typo.body2">
                При получении нового SMS сообщения приложение ищет отправителя в этом списке. 
                Если совпадение найдено, текст SMS обрабатывается регулярными выражениями (Regex) для извлечения суммы, даты и типа операции.
            </MudText>
            <MudText Typo="Typo.body2" Class="mt-2" Style="font-weight: bold;">Типичный процесс:</MudText>
            <MudList T="string" Dense="true">
                <MudListItem Text="1. Поиск банка по номеру отправителя (напр. 'Alfa-Bank')." Icon="@Icons.Material.Filled.Search" />
                <MudListItem Text="2. Запуск Regex для извлечения суммы, валюты и описания." Icon="@Icons.Material.Filled.Code" />
                <MudListItem Text="3. Определение типа (Оплата/Доход/Наличные) по ключевым словам." Icon="@Icons.Material.Filled.Category" />
            </MudList>
        </MudExpansionPanel>
    </MudExpansionPanels>
</div>

@code {
    private List<BankConfiguration> _banks => ConfigurationManager.ConfigManager.BankConfigurationFromJson.Banks;

    private async Task AddBank()
    {
        var newBank = new BankConfiguration
        {
            Name = "Новый банк",
            SmsNumber = "",
            SmsParseRegex = new SmsParseRegex(),
            PdfReportTemplate = new PdfReportTemplate(),
            PaymentTemplates = new[] { "OPLATA" },
            DepositTemplates = new[] { "ZACHISLENIE" },
            CashTemplates = new[] { "NALICHNYE" }
        };

        var parameters = new DialogParameters { ["Model"] = newBank, ["Title"] = "Добавить новый банк" };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<BankRuleDialog>("Настройка банка", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            _banks.Add((BankConfiguration)result.Data);
            ConfigurationManager.ConfigManager.Save();
            Snackbar.Add("Конфигурация банка добавлена", Severity.Success);
            StateHasChanged();
        }
    }

    private async Task EditBank(BankConfiguration bank)
    {
        // Для отмены изменений лучше работать с копией
        var clone = JsonConvert.DeserializeObject<BankConfiguration>(JsonConvert.SerializeObject(bank));
        
        var parameters = new DialogParameters { ["Model"] = clone, ["Title"] = $"Редактирование {bank.Name}" };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<BankRuleDialog>("Настройка банка", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            // Находим индекс и заменяем оригинал обновленной копией
            var index = _banks.IndexOf(bank);
            if (index != -1)
            {
                _banks[index] = (BankConfiguration)result.Data;
                ConfigurationManager.ConfigManager.Save();
                Snackbar.Add("Изменения успешно сохранены", Severity.Success);
                StateHasChanged();
            }
        }
    }

    private async Task DuplicateBank(BankConfiguration bank)
    {
        var clone = JsonConvert.DeserializeObject<BankConfiguration>(JsonConvert.SerializeObject(bank));
        clone.Name += " (Копия)";
        
        _banks.Add(clone);
        ConfigurationManager.ConfigManager.Save();
        Snackbar.Add($"Конфигурация '{bank.Name}' скопирована", Severity.Info);
        StateHasChanged();
    }

    private async Task DeleteBank(BankConfiguration bank)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Удаление конфигурации", 
            $"Вы действительно хотите удалить настройки для '{bank.Name}'? Это повлияет на будущий парсинг сообщений от этого отправителя.", 
            yesText: "Удалить", noText: "Отмена");

        if (confirmed == true)
        {
            _banks.Remove(bank);
            ConfigurationManager.ConfigManager.Save();
            Snackbar.Add("Конфигурация удалена", Severity.Warning);
            StateHasChanged();
        }
    }
}

