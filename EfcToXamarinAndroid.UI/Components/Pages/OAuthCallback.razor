@page "/oauth-callback"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using EfcToXamarinAndroid.Core.Services
@using EfcToXamarinAndroid.Core.Configs.ManagerCore
@inject NavigationManager Navigation
@inject OAuthService OAuthService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Class="pa-4 d-flex flex-column align-center">
        @if (_isProcessing)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Class="mt-4">Авторизация @(_providerName ?? "Google")...</MudText>
            <MudText Typo="Typo.caption">Обмен кода на токен</MudText>
        }
        else if (_errorMessage != null)
        {
            <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Large" />
            <MudText Color="Color.Error" Class="mt-2">Ошибка авторизации</MudText>
            <MudText>@_errorMessage</MudText>
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/settings"))">Вернуться в настройки</MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    private bool _isProcessing = true;
    private bool _hasProcessed = false;
    private string? _errorMessage;
    private string? _providerName;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hasProcessed) return;
        _hasProcessed = true;
        
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = new Dictionary<string, string>();
        if (!string.IsNullOrEmpty(uri.Query))
        {
             var q = uri.Query.TrimStart('?');
             foreach(var part in q.Split('&'))
             {
                 var kv = part.Split('=', 2);
                 if(kv.Length == 2) query[kv[0]] = Uri.UnescapeDataString(kv[1]);
                 else if(kv.Length == 1) query[kv[0]] = "";
             }
        }

        if (query.TryGetValue("code", out var code))
        {
            try
            {
                var redirectUri = Navigation.BaseUri + "oauth-callback"; 
                Console.WriteLine($"[OAuthCallback] Using Redirect URI: {redirectUri}");

                var config = ConfigurationManager.ConfigManager.BankConfigurationFromJson.EmailSettings;
                
                var providerName = config.OAuthProvider ?? "Google";
                _providerName = providerName;
                
                string clientId, clientSecret;
                if (providerName.Equals("Yandex", StringComparison.OrdinalIgnoreCase))
                {
                    clientId = !string.IsNullOrEmpty(config.ClientId) ? config.ClientId : EfcToXamarinAndroid.Core.Configs.YandexAuthConfig.Default.ClientId;
                    clientSecret = !string.IsNullOrEmpty(config.ClientSecret) ? config.ClientSecret : EfcToXamarinAndroid.Core.Configs.YandexAuthConfig.Default.ClientSecret;
                }
                else
                {
                    clientId = !string.IsNullOrEmpty(config.ClientId) ? config.ClientId : EfcToXamarinAndroid.Core.Configs.GoogleAuthConfig.Default.ClientId;
                    clientSecret = !string.IsNullOrEmpty(config.ClientSecret) ? config.ClientSecret : EfcToXamarinAndroid.Core.Configs.GoogleAuthConfig.Default.ClientSecret;
                }

                if (clientId == "YOUR_CLIENT_ID_HERE" || clientSecret == "YOUR_CLIENT_SECRET_HERE")
                {
                    throw new Exception($"Client ID/Secret для {providerName} не настроены");
                }

                var tokens = await OAuthService.ExchangeCodeForTokenAsync(providerName, code, clientId, clientSecret, redirectUri);

                config.AccessToken = tokens.AccessToken;
                if (!string.IsNullOrEmpty(tokens.RefreshToken))
                {
                    config.RefreshToken = tokens.RefreshToken;
                }
                config.TokenExpiry = DateTime.Now.AddSeconds(tokens.ExpiresIn);
                
                ConfigurationManager.ConfigManager.Save();

                Snackbar.Add($"Успешный вход через {providerName}!", Severity.Success);
                Navigation.NavigateTo("/settings");
            }
            catch (Exception ex)
            {
                _errorMessage = ex.Message;
                _isProcessing = false;
                StateHasChanged();
            }
        }
        else if (query.TryGetValue("error", out var error))
        {
            _errorMessage = $"Провайдер вернул ошибку: {error}";
            _isProcessing = false;
            StateHasChanged();
        }
        else
        {
            _errorMessage = "Код авторизации не найден.";
            _isProcessing = false;
            StateHasChanged();
        }
    }
}
