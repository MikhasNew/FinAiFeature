@using MudBlazor
@using EfcToXamarinAndroid.Core.Configs.ManagerCore
@using EfcToXamarinAndroid.Core
@using EfcToXamarinAndroid.Core.Parsers
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@using Newtonsoft.Json
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudTabs Elevation="0" Outlined="true" PanelClass="pa-4" Style="min-height: 450px;">
            <MudTabPanel Text="Основное">
                <MudTextField @bind-Value="Model.Name" Label="Название правила" Required="true" Variant="Variant.Outlined" Class="mb-4" />
                <MudTextField @bind-Value="Model.SenderEmail" Label="Email отправителя" Variant="Variant.Outlined" Class="mb-4" 
                             HelperText="Например: no-reply@shop.by" />
                <MudTextField @bind-Value="Model.UrlPattern" Label="Паттерн URL (Regex)" Variant="Variant.Outlined" 
                             HelperText="Для парсинга QR/Web чеков" />
            </MudTabPanel>
            
            <MudTabPanel Text="Regex (Чек)">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                    Regex для извлечения данных чека. Используйте группу захвата (скобки) для значения.
                </MudAlert>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.ShopName" Label="Магазин/Получатель" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                     HelperText="Пример: Магазин:\s*(.+)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.TotalSum" Label="Сумма" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                     HelperText="Пример: Сумма:\s*(\d+[.,]\d{2})" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.ReceiptDate" Label="Дата" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                     HelperText="Пример: Дата:\s*([\d\.]+\s[\d:]+)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.Currency" Label="Валюта" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.RegNumber" Label="Рег. номер" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.CardNumber" Label="Номер карты" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.EripPayerNumber" Label="Номер ЕРИП" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.OrderNumber" Label="Номер заказа" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.ShopInn" Label="ИНН/УНП" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.Address" Label="Адрес" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="Model.ParseRegex.Subject" Label="Тема/Назначение платежа" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Regex (Товары)">
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                    Опционально: для чеков с несколькими позициями. ItemLine должен находить каждую строку товара.
                </MudAlert>
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="Model.ParseRegex.ItemLine" Label="Паттерн строки товара" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     HelperText="Regex, который матчит одну позицию товара" Lines="2" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.ItemName" Label="Название товара" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.ItemQuantity" Label="Количество" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.ItemPrice" Label="Цена за единицу" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.ItemSum" Label="Сумма позиции" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.ParseRegex.ItemCode" Label="Код товара" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Тест" Icon="@Icons.Material.Filled.Science">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                    Вставьте текст чека или загрузите PDF-файл для проверки regex-паттернов
                </MudAlert>
                
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudFileUpload T="IBrowserFile" 
                                   Accept=".pdf" 
                                   FilesChanged="OnPdfFileSelected"
                                   MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                       Disabled="@_isLoadingPdf">
                                @if (_isLoadingPdf)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Загрузка...</span>
                                }
                                else
                                {
                                    <span>Загрузить PDF</span>
                                }
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    @if (!string.IsNullOrEmpty(_loadedFileName))
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                            @_loadedFileName
                        </MudChip>
                    }
                </MudStack>
                
                <MudTextField @bind-Value="_testInput" 
                              Label="Текст чека" 
                              Lines="8" 
                              Variant="Variant.Outlined"
                              Placeholder="Вставьте текст или загрузите PDF..."
                              Class="mb-4" />
                <MudButton OnClick="TestRegex" 
                           Variant="Variant.Filled" 
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@string.IsNullOrWhiteSpace(_testInput)">
                    Проверить парсинг
                </MudButton>
                
                @if (_testResult != null)
                {
                    <MudPaper Elevation="2" Class="pa-4 mt-4">
                        <MudText Typo="Typo.subtitle1" Color="Color.Success" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                            Результат парсинга:
                        </MudText>
                        <MudSimpleTable Dense="true" Hover="true">
                            <tbody>
                                @if (!string.IsNullOrEmpty(_testResult.ShopName))
                                {
                                    <tr><td><strong>Магазин:</strong></td><td>@_testResult.ShopName</td></tr>
                                }
                                @if (_testResult.TotalSum > 0)
                                {
                                    <tr><td><strong>Сумма:</strong></td><td>@_testResult.TotalSum @_testResult.Currency</td></tr>
                                }
                                @if (_testResult.ReceiptDate != default)
                                {
                                    <tr><td><strong>Дата:</strong></td><td>@_testResult.ReceiptDate.ToString("dd.MM.yyyy HH:mm")</td></tr>
                                }
                                @if (!string.IsNullOrEmpty(_testResult.RegNumber))
                                {
                                    <tr><td><strong>Рег. номер:</strong></td><td>@_testResult.RegNumber</td></tr>
                                }
                                @if (!string.IsNullOrEmpty(_testResult.CardNumber))
                                {
                                    <tr><td><strong>Карта:</strong></td><td>@_testResult.CardNumber</td></tr>
                                }
                                @if (!string.IsNullOrEmpty(_testResult.OrderNumber))
                                {
                                    <tr><td><strong>№ заказа:</strong></td><td>@_testResult.OrderNumber</td></tr>
                                }
                                @if (!string.IsNullOrEmpty(_testResult.Subject))
                                {
                                    <tr><td><strong>Назначение:</strong></td><td>@_testResult.Subject</td></tr>
                                }
                                @if (_testResult.Items?.Count > 0)
                                {
                                    <tr><td><strong>Товаров:</strong></td><td>@_testResult.Items.Count позиций</td></tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudPaper>
                }
                else if (_testExecuted)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-4">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-1" />
                        Не удалось распарсить данные. Проверьте regex-паттерны.
                    </MudAlert>
                }
                <MudExpansionPanels Class="mt-4">
                    <MudExpansionPanel Text="🧠 Помощь AI (ChatGPT/Claude/Gemini)" Icon="@Icons.Material.Filled.SmartToy">
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            Чтобы получить готовые Regex-выражения:
                            <ol class="ma-0 pl-4">
                                <li>Скопируйте <b>Текст чека</b> и <b>JSON структуру</b></li>
                                <li>Отправьте их в AI чат с промоптом: <i>"Напиши Regex pattern-ы (C#) для извлечения данных из этого текста в эту JSON структуру"</i></li>
                                <li>Вставьте полученные паттерны в настройки правила</li>
                            </ol>
                        </MudAlert>
                        
                        <MudStack Row="true" Spacing="2" Class="mb-2">
                            <MudButton Variant="Variant.Outlined" 
                                       StartIcon="@Icons.Material.Filled.ContentCopy" 
                                       OnClick="CopyTextCleanup"
                                       Disabled="@string.IsNullOrWhiteSpace(_testInput)">
                                Копировать текст чека
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       StartIcon="@Icons.Material.Filled.ContentCopy" 
                                       OnClick="CopyJsonStructure">
                                Копировать JSON структуру
                            </MudButton>
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.AutoAwesome" 
                                       OnClick="CopyFullPrompt"
                                       Disabled="@string.IsNullOrWhiteSpace(_testInput)">
                                Копировать готовый ПРОМПТ
                            </MudButton>
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Variant="Variant.Filled">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public ReceiptConfiguration Model { get; set; } = new();
    [Parameter] public string Title { get; set; } = "Настройка правила";

    private string _testInput = "";
    private Receipt? _testResult;
    private bool _testExecuted = false;
    private bool _isLoadingPdf = false;
    private string? _loadedFileName;

    protected override void OnInitialized()
    {
        // Ensure ParseRegex is not null
        Model.ParseRegex ??= new ReceiptParseRegex();
    }

    async Task OnPdfFileSelected(IBrowserFile file)
    {
        if (file == null) return;
        
        _isLoadingPdf = true;
        _loadedFileName = null;
        StateHasChanged();
        
        try
        {
            // Max 10MB
            const long maxSize = 10 * 1024 * 1024;
            
            using var stream = new System.IO.MemoryStream();
            await file.OpenReadStream(maxSize).CopyToAsync(stream);
            stream.Position = 0;
            
            using var document = UglyToad.PdfPig.PdfDocument.Open(stream);
            var textBuilder = new System.Text.StringBuilder();
            
            foreach (var page in document.GetPages())
            {
                textBuilder.AppendLine(page.Text);
            }
            
            _testInput = textBuilder.ToString();
            _loadedFileName = file.Name;
            _testResult = null;
            _testExecuted = false;
            
            Snackbar.Add($"Текст извлечен из PDF ({document.NumberOfPages} стр.)", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка чтения PDF: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingPdf = false;
            StateHasChanged();
        }
    }

    void TestRegex()
    {
        _testExecuted = true;
        _testResult = null;
        
        if (string.IsNullOrWhiteSpace(_testInput))
        {
            Snackbar.Add("Введите текст для тестирования", Severity.Warning);
            return;
        }

        try
        {
            var testConfig = new ReceiptConfiguration
            {
                Name = Model.Name,
                SenderEmail = Model.SenderEmail ?? "test@test.com",
                ParseRegex = Model.ParseRegex
            };
            
            var parser = new ReceiptParser(new List<ReceiptConfiguration> { testConfig });
            _testResult = parser.Parse(_testInput, testConfig.SenderEmail, true);
            
            if (_testResult != null && _testResult.TotalSum > 0)
            {
                Snackbar.Add("Парсинг успешен!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Данные не найдены. Проверьте regex-паттерны.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка парсинга: {ex.Message}", Severity.Error);
        }
        
        StateHasChanged();
    }

    void Submit()
    {
        if (string.IsNullOrWhiteSpace(Model.Name))
        {
            Snackbar.Add("Введите название правила", Severity.Warning);
            return;
        }
        
        // Validate all regex patterns
        var regexFields = new Dictionary<string, string?>
        {
            { "Магазин", Model.ParseRegex?.ShopName },
            { "Сумма", Model.ParseRegex?.TotalSum },
            { "Дата", Model.ParseRegex?.ReceiptDate },
            { "Валюта", Model.ParseRegex?.Currency },
            { "URL паттерн", Model.UrlPattern },
            { "Строка товара", Model.ParseRegex?.ItemLine }
        };

        foreach (var field in regexFields)
        {
            if (!ValidateRegexPattern(field.Value, out string? error))
            {
                Snackbar.Add($"Некорректный regex в поле \"{field.Key}\": {error}", Severity.Error);
                return;
            }
        }
        
        MudDialog.Close(DialogResult.Ok(Model));
    }

    bool ValidateRegexPattern(string? pattern, out string? error)
    {
        error = null;
        if (string.IsNullOrEmpty(pattern)) return true;
        
        try
        {
            _ = new Regex(pattern, RegexOptions.None, TimeSpan.FromSeconds(1));
            return true;
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
            return false;
        }
    }

    async Task CopyTextCleanup()
    {
        if (string.IsNullOrWhiteSpace(_testInput)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _testInput);
        Snackbar.Add("Текст чека скопирован", Severity.Success);
    }

    async Task CopyJsonStructure()
    {
        var dummyReceipt = new Receipt
        {
            ShopName = "Название Магазина",
            TotalSum = 123.45f,
            ReceiptDate = DateTime.Now,
            Currency = "BYN",
            CardNumber = "**** 1234",
            RegNumber = "УНП 123456789",
            OrderNumber = "Check #12345",
            Items = new List<ReceiptItem>
            {
                new ReceiptItem { Name = "Товар 1", Price = 10.00f, Quantity = 2, Sum = 20.00f }
            }
        };
        var json = JsonConvert.SerializeObject(dummyReceipt, Formatting.Indented);
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", json);
        Snackbar.Add("JSON структура скопирована", Severity.Success);
    }

    async Task CopyFullPrompt()
    {
        if (string.IsNullOrWhiteSpace(_testInput)) return;
        
        var dummyReceipt = new Receipt
        {
            ShopName = "String value",
            TotalSum = 0.00f,
            ReceiptDate = DateTime.Now,
            Currency = "ISO Code",
            CardNumber = "String",
            RegNumber = "String",
            Items = new List<ReceiptItem>
            {
                new ReceiptItem { Name = "String", Price = 0.00f, Quantity = 0, Sum = 0.00f }
            }
        };
        var json = JsonConvert.SerializeObject(dummyReceipt, Formatting.Indented);
        
        var prompt = $@"I need C# Regex patterns to parse the following receipt text into the provided JSON structure.

RECEIPT TEXT:
{_testInput}

TARGET JSON STRUCTURE:
{json}

Please provide specific Regex strings for:
- ShopName
- TotalSum
- ReceiptDate
- ItemLine (to match each item row)
- ItemName
- ItemPrice
- ItemQuantity";

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", prompt);
        Snackbar.Add("Сгенерированный промпт скопирован!", Severity.Success);
    }

    void Cancel() => MudDialog.Cancel();
}
